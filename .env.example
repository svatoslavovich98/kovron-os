# Режим данных: "demo" — работает сразу без базы, на встроенных демо-данных.
# "supabase" — реальные данные из вашего проекта Supabase.
NEXT_PUBLIC_DATA_MODE=demo

# Данные вашего проекта Supabase (Settings -> API).
# Обязательны только в режиме NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
